# Non-secret runtime configuration. Keep real values in .env (mode 0600).
ALLOWED_USER_IDS=123456789
AUTH_RECIPIENT_IDS=123456789
BILLING_RECIPIENT_IDS=123456789
INCIDENT_RECIPIENT_IDS=123456789
GENERAL_RECIPIENT_IDS=123456789
ADMIN_USER_IDS=123456789

CHECK_INTERVAL=15
STATUS_CHECK_INTERVAL=60
AUTH_EMAIL_MAX_AGE_SECONDS=900
BILLING_EMAIL_MAX_AGE_SECONDS=172800
DISPLAY_TIMEZONE=Europe/Saratov
LANGUAGE=ru

ENABLE_CLAUDE_EMAILS=true
ENABLE_OPENAI_EMAILS=true
ENABLE_BILLING_EMAILS=true
ENABLE_OPENAI_INCIDENTS=true

GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=data/token.json
STATE_DB_FILE=data/bot.db
ADMIN_STATE_FILE=data/admin_state.json

# The container listens on all interfaces, but Compose publishes it only on
# host loopback. Use an SSH tunnel for one-time Gmail reauthorization.
OAUTH_PORT=8080
OAUTH_BIND_HOST=0.0.0.0
